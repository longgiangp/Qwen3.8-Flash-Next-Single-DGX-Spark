# Single-Spark production profile qualified on 2026-09-07.
# Copy to .env only after reading deployment/README.md.
# Values below describe this fork's measured profile, not upstream's other hosts.
# A shell environment override wins: MAX_MODEL_LEN=65536 ./start.sh
#
# This is the standard Mia third-party quantization on Hugging Face, not an
# official Qwen-distributed checkpoint and not the optional abliterated variant.
IMAGE="vllm/vllm-openai:qwen38-flash-next@sha256:fc120ece0a388cc0aa1caad4a9f1cd92113484ab7ec2fd0efadd62585be05bf8"
SERVED_MODEL_NAME="qwen3.8-flash-next"
TP1_MODEL_ID="Mia-AiLab/Qwen3.8-Flash-Next-NVFP4"
MODEL_REVISION="925d7be6c14c6c9442ef83e8f05b5a3c39304f69"
HF_HOME="/var/lib/qwen3.8-flash-next/huggingface"
ALLOW_IMAGE_PULL=0                  # provision the pinned image explicitly before startup
ABLIT=0                            # this production service rejects unqualified alternate weights
BIND_HOST="127.0.0.1"               # no LAN/public exposure; use your own authenticated TLS proxy
PORT=8888

# Native context, not YaRN extrapolation. Leave headroom for generated tokens.
YARN=0
MAX_MODEL_LEN=262144
YARN_MAX_MODEL_LEN=524288           # ignored with YARN=0; not qualified by this fork

# Inherited Mia optimizations, integrated into the measured production profile.
MTP_NUM_SPECULATIVE_TOKENS=3
KV_CACHE_DTYPE=fp8
MAMBA_SSM_CACHE_DTYPE=bfloat16
MAX_NUM_SEQS=8                     # eight SHORT active requests, not eight full 262k contexts
MAX_NUM_BATCHED_TOKENS=2048         # long prefills can still delay live decode streams
CUDAGRAPH_CAPTURE_SIZES=auto        # MTP3 verify widths: 4,8,12,16,20,24,28,32
COMPILATION_MODE=0
MTP_K_SCHEDULE=                     # fixed depth; no dynamic schedule qualified
EXTRA_DOCKER_ARGS="-e VLLM_USE_V2_MODEL_RUNNER=1"
EXTRA_VLLM_ARGS=--no-enable-flashinfer-autotune

# Unified-memory headroom is more important than requesting a large KV pool.
# KV_TARGET is a wish clipped by the host cap. Actual qualified allocation:
# 5.41 GiB / 360,264 tokens (~1.37 full 262k requests), NOT 20 GiB.
KV_TARGET_GIB=20
HOST_RESERVE_GIB=36
HOST_SLACK_GIB=5
CONTAINER_MEM_GIB=90                # explicit cgroup cap; startup requires 94 GiB MemAvailable
# Fixed KV pool (5 GiB = ~333k tokens at fp8, 1.27x one 262k request). vLLM otherwise sizes the pool
# from a startup memory profile that is not reproducible on this unified-memory host: identical
# config gave 3.54 / 6.86 / 8.3 / 9.32 GiB in four launches (3.54 < the 3.92 GiB one 262k request
# needs, so that launch refused to start). A pin skips the profile; see deployment/README.md.
# 5, not 6 GiB: with 6 GiB the driver-held memory settled at ~89.5 GB and MemAvailable at ~5.6 GiB, only
# ~1.5 GiB above the watchdog floor, and it grew by ~3 GB under 250k-token load. 5 GiB gives ~1 GiB back.
KV_CACHE_MEMORY=5368709120
# GPU-driver allocations are not all bounded by the container cgroup cap.

# These thresholds were qualified WITH files/sysctl-spark3.conf applied:
# min_free_kbytes=4194304, watermark_scale_factor=300, swappiness=30.
# They change MemAvailable accounting; do not compare raw upstream-host values.
MEMWATCH_MIN_GIB=4
MEMWATCH_MIN_FREE_GIB=4
MEMWATCH_FREE_GATE_GIB=10
# The launcher uses the watchdog's five-consecutive-sample debounce.

# Built offline from a local corpus. The measured private corpus/artifact is NOT
# distributed. Your corpus may produce different IDs, size and draft acceptance.
# 65k is the requested maximum; the measured artifact contained 55,124 unique IDs.
# See deployment/README.md for building your own or opting out (unmeasured).
MTP_DRAFT_VOCAB=/var/lib/qwen3.8-flash-next/draft_vocab/qwen38fn_local_code_65k.txt
